  {
    "id": "w_stats",
    "type": "ui_template",
    "z": "tab_esp",
    "group": "g_est",
    "name": "tabela de estatística",
    "order": 1,
    "width": "8",
    "height": "4",
    "format": "<div ng-if=\"msg.payload.amostras !== undefined\">\n  <p style=\"margin:0 0 10px\">\n    Amostras analisadas: <b>{{msg.payload.amostras}}</b>\n    <span ng-if=\"msg.payload.inicio\"> · desde {{msg.payload.inicio}}</span>\n  </p>\n  <table style=\"width:100%; border-collapse:collapse; text-align:right\">\n    <tr style=\"border-bottom:1px solid rgba(128,128,128,.4)\">\n      <th style=\"text-align:left\">Variável</th><th>Média</th><th>Desvio padrão</th><th>Mínimo</th><th>Máximo</th>\n    </tr>\n    <tr>\n      <td style=\"text-align:left\">Temperatura (°C)</td>\n      <td>{{msg.payload.temperatura.media | number:2}}</td><td>{{msg.payload.temperatura.dp | number:2}}</td>\n      <td>{{msg.payload.temperatura.min | number:2}}</td><td>{{msg.payload.temperatura.max | number:2}}</td>\n    </tr>\n    <tr>\n      <td style=\"text-align:left\">Umidade (%)</td>\n      <td>{{msg.payload.umidade.media | number:2}}</td><td>{{msg.payload.umidade.dp | number:2}}</td>\n      <td>{{msg.payload.umidade.min | number:2}}</td><td>{{msg.payload.umidade.max | number:2}}</td>\n    </tr>\n    <tr>\n      <td style=\"text-align:left\">Pressão (hPa)</td>\n      <td>{{msg.payload.pressao.media | number:2}}</td><td>{{msg.payload.pressao.dp | number:2}}</td>\n      <td>{{msg.payload.pressao.min | number:2}}</td><td>{{msg.payload.pressao.max | number:2}}</td>\n    </tr>\n    <tr>\n      <td style=\"text-align:left\">Altitude (m)</td>\n      <td>{{msg.payload.altitude.media | number:1}}</td><td>{{msg.payload.altitude.dp | number:2}}</td>\n      <td>{{msg.payload.altitude.min | number:1}}</td><td>{{msg.payload.altitude.max | number:1}}</td>\n    </tr>\n  </table>\n</div>\n<div ng-if=\"msg.payload.amostras === undefined\">Aguardando o ESP...</div>",
    "storeOutMessages": true,
    "fwdInMessages": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 710,
    "y": 480,
    "wires": [
      []
    ]
  }
]