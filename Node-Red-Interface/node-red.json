  {
    "id": "f_sep",
    "type": "function",
    "z": "tab_esp",
    "name": "separa leituras",
    "func": "// Saídas: 1 gauge T | 2 gauge U | 3 gauge P | 4 gráfico T | 5 gráfico U | 6 gráfico P\n//         7 toques do botão | 8 estado do botão | 9 status | 10 switch do LED\nif (msg.statusCode !== 200) {\n    return [null, null, null, null, null, null, null, null, { payload: '🔴 Offline' }, null];\n}\n\nconst d = msg.payload;\nreturn [\n    { payload: d.temperatura },\n    { payload: d.umidade },\n    { payload: d.pressao },\n    { topic: 'Temperatura', payload: d.temperatura },\n    { topic: 'Umidade', payload: d.umidade },\n    { topic: 'Pressão', payload: d.pressao },\n    { payload: d.toques_botao ?? 0 },\n    { payload: d.botao ? 'Pressionado' : 'Solto' },\n    { payload: '🟢 Online · fw ' + d.versao },\n    { payload: d.led ? '1' : '0' }      // mantém o switch igual ao estado real do LED\n];",
    "outputs": 10,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 680,
    "y": 180,
    "wires": [
      [
        "w_gT"
      ],
      [
        "w_gU"
      ],
      [
        "w_gP"
      ],
      [
        "w_cT"
      ],
      [
        "w_cU"
      ],
