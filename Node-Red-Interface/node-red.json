  {
    "id": "f_cmd",
    "type": "function",
    "z": "tab_esp",
    "name": "monta comando POST",
    "func": "// Monta o POST para o ESP. O topic diz qual rota usar.\nconst ip = flow.get('esp_ip');\nif (!ip) return null;\nmsg.method = 'POST';\nmsg.requestTimeout = 2000;\nif (msg.topic === 'led') {\n    msg.url = `http://${ip}/led?estado=${msg.payload}`;\n} else {\n    msg.url = `http://${ip}/${msg.topic}`;      // ex.: stats/reset\n}\nmsg.payload = '';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 700,
    "wires": [
      [
        "h_cmd"
      ]
    ]
  },
