    {
        "id": "68ac507b7851802e",
        "type": "function",
        "z": "f1a265404c7b2006",
        "name": "controle automatico",
        "func": "// Liga/desliga o LED sozinho conforme o limite de temperatura\nif (msg.statusCode !== 200) return null;\n\nconst d = msg.payload;\nif (!d || !d.sensor_ok || typeof d.temperatura !== 'number') return null;\nif (!flow.get('modo_auto')) return null;            // modo automático desligado\n\nconst limite = Number(flow.get('limite_temp') ?? 30);\nconst HIST   = 0.5;   // histerese em °C\nconst T      = d.temperatura;\n\n// Passou do limite e o LED está apagado → liga\nif (T >= limite && !d.led) {\n    return { topic: 'led', payload: '1' };\n}\n// Voltou abaixo de (limite - histerese) e o LED está aceso → desliga\nif (T < limite - HIST && d.led) {\n    return { topic: 'led', payload: '0' };\n}\nreturn null;   // nada a fazer",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1010,
        "y": 500,
        "wires": [
            [
                "7c4584b25ad9d92a"
            ]
        ]
    },
    {
        "id": "da2eaf04fd95dcd0",
        "type": "function",
        "z": "f1a265404c7b2006",
        "name": "info do sistema",
        "func": "// Saídas: 1 gauge do sinal Wi-Fi | 2 tempo ligado | 3 memória livre\nif (msg.statusCode !== 200 || !msg.payload) {\n    return [null, { payload: '—' }, { payload: '—' }];\n}\n\nconst d = msg.payload;\n\n// uptime_s (segundos) → \"1d 3h 25min 10s\"\nconst s = d.uptime_s || 0;\nconst dias = Math.floor(s / 86400);\nconst h = Math.floor((s % 86400) / 3600);\nconst min = Math.floor((s % 3600) / 60);\nconst seg = s % 60;\nconst uptime = (dias ? dias + 'd ' : '') + h + 'h ' + min + 'min ' + seg + 's';\n\n// heap_livre (bytes) → kB\nconst memoria = ((d.heap_livre || 0) / 1024).toFixed(1) + ' kB';\n\nreturn [\n    { payload: d.rssi },\n    { payload: uptime },\n    { payload: memoria }\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
