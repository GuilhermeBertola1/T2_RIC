    {
        "id": "433e9e96a59d7eb4",
        "type": "function",
        "z": "f1a265404c7b2006",
        "name": "verifica temperatura",
        "func": "if (msg.statusCode !== 200) {\n    return { payload: '🔴 Sem conexão com a placa' };\n}\n\nconst dados = msg.payload;\nif (!dados || !dados.sensor_ok || typeof dados.temperatura !== 'number' || !Number.isFinite(dados.temperatura)) {\n    return { payload: '⚠️ Sensor indisponível' };\n}\n\nconst limite = Number(flow.get('limite_temp') ?? 30);\nconst temperatura = dados.temperatura;\nreturn {\n    payload: temperatura >= limite\n        ? `ALERTA: ${temperatura.toFixed(1)} °C (limite ${limite} °C)`\n        : `Normal: ${temperatura.toFixed(1)} °C (limite ${limite} °C)`\n};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
