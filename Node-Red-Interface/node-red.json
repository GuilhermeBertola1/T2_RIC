    {
        "id": "7ce9a8fba0cb6b21",
        "type": "function",
        "z": "f1a265404c7b2006",
        "name": "salva limite",
        "func": "const limite = Number(msg.payload);\nif (Number.isFinite(limite) && limite >= 0 && limite <= 50) {\n    flow.set('limite_temp', limite);\n}\nreturn null;",
        "outputs": 1,
